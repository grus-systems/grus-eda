create_clock -name core_clk -period 5.0 [get_ports clk]
set_clock_uncertainty 0.1 [get_clocks core_clk]
set_input_delay 0.5 -clock core_clk [get_ports p_ln]
set_input_delay 3.6 -clock core_clk [get_ports p_ln2]
set_input_delay 3.0 -clock core_clk [get_ports p_lp]
set_input_delay 1.0 -clock core_clk [get_ports p_lp2]
set_input_delay 3.8 -clock core_clk [get_ports p_xbn]
set_input_delay 1.4 -clock core_clk [get_ports p_xbp]
set_input_delay 3.3 -clock core_clk [get_ports p_rtn]
set_input_delay 1.8 -clock core_clk [get_ports p_rtp]
set_input_delay 4.4 -clock core_clk [get_ports p_rbn]
set_input_delay 0.9 -clock core_clk [get_ports p_rbp]
set_input_delay 1.5 -clock core_clk [get_ports p_iso]
set_input_delay 0.8 -clock core_clk [get_ports rst]
set_output_delay 0.5 -clock core_clk [all_outputs]
set_input_transition 0.15 [all_inputs]
set_max_delay 1.0 -from [get_ports p_lp] -to [get_pins u_lp/D]
