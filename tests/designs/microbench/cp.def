VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN cp ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
ROW ROW_0 unithd 0 0 N DO 1 BY 1 STEP 460 0 ;
TRACKS X 10 DO 10 STEP 1000 LAYER li1 ;
TRACKS Y 10 DO 10 STEP 1000 LAYER li1 ;
COMPONENTS 9 ;
    - u_c sky130_fd_sc_hd__conb_1 + PLACED ( 2000 2000 ) N ;
    - u_andh sky130_fd_sc_hd__and2_1 + PLACED ( 2000 4000 ) N ;
    - u_xorh sky130_fd_sc_hd__xor2_1 + PLACED ( 4000 4000 ) N ;
    - u_orh sky130_fd_sc_hd__or2_1 + PLACED ( 2000 6000 ) N ;
    - u_andl sky130_fd_sc_hd__and2_1 + PLACED ( 4000 6000 ) N ;
    - u_orl sky130_fd_sc_hd__or2_1 + PLACED ( 2000 8000 ) N ;
    - u_xorl sky130_fd_sc_hd__xor2_1 + PLACED ( 4000 8000 ) N ;
    - u_andhh sky130_fd_sc_hd__and2_1 + PLACED ( 6000 6000 ) N ;
    - u_bufh sky130_fd_sc_hd__buf_1 + PLACED ( 6000 8000 ) N ;
END COMPONENTS
PINS 2 ;
    - a + NET a + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met1 ( -140 -140 ) ( 140 140 )
        + PLACED ( 140 140 ) N ;
    - y + NET n_xorh + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met1 ( -140 -140 ) ( 140 140 )
        + PLACED ( 9860 140 ) N ;
END PINS
NETS 11 ;
    - a ( PIN a ) ( u_andh B ) ( u_xorh B ) ( u_orh B ) ( u_andl B ) ( u_orl B ) ( u_xorl B ) + USE SIGNAL ;
    - n_hi ( u_c HI ) ( u_andh A ) ( u_xorh A ) ( u_orh A ) ( u_andhh A ) ( u_andhh B ) ( u_bufh A ) + USE SIGNAL ;
    - n_lo ( u_c LO ) ( u_andl A ) ( u_orl A ) ( u_xorl A ) + USE SIGNAL ;
    - n_andh ( u_andh X ) + USE SIGNAL ;
    - n_xorh ( u_xorh X ) ( PIN y ) + USE SIGNAL ;
    - n_orh ( u_orh X ) + USE SIGNAL ;
    - n_andl ( u_andl X ) + USE SIGNAL ;
    - n_orl ( u_orl X ) + USE SIGNAL ;
    - n_xorl ( u_xorl X ) + USE SIGNAL ;
    - n_andhh ( u_andhh X ) + USE SIGNAL ;
    - n_bufh ( u_bufh X ) + USE SIGNAL ;
END NETS
END DESIGN
