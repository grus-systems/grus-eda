VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN sta_clocks_latch ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW ROW_0 unithd 0 0 N DO 43 BY 1 STEP 460 2720 ;
ROW ROW_1 unithd 0 2720 N DO 43 BY 1 STEP 460 2720 ;
ROW ROW_2 unithd 0 5440 N DO 43 BY 1 STEP 460 2720 ;
TRACKS X 170 DO 100 STEP 340 LAYER met1 ;
TRACKS Y 140 DO 100 STEP 340 LAYER met2 ;
COMPONENTS 5 ;
- u_clka sky130_fd_sc_hd__clkbuf_2 + PLACED ( 4600 0 ) N ;
- u_clkb sky130_fd_sc_hd__clkbuf_2 + PLACED ( 4600 2720 ) N ;
- u_ln sky130_fd_sc_hd__dlxtn_1 + PLACED ( 9200 2720 ) N ;
- u_fb0 sky130_fd_sc_hd__dfxtp_1 + PLACED ( 13800 2720 ) N ;
- u_fa0 sky130_fd_sc_hd__dfxtp_1 + PLACED ( 9200 0 ) N ;
END COMPONENTS
PINS 5 ;
- clk1 + NET clk1 + DIRECTION INPUT + USE SIGNAL + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 0 0 ) N ;
- clk2 + NET clk2 + DIRECTION INPUT + USE SIGNAL + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 0 2720 ) N ;
- d1 + NET d1 + DIRECTION INPUT + USE SIGNAL + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 0 4080 ) N ;
- d2 + NET d2 + DIRECTION INPUT + USE SIGNAL + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 0 5440 ) N ;
- ya + NET ya + DIRECTION OUTPUT + USE SIGNAL + LAYER met1 ( -70 -70 ) ( 70 70 ) + PLACED ( 0 6800 ) N ;
END PINS
NETS 8 ;
- clk1 ( PIN clk1 ) ( u_clka A ) + USE SIGNAL ;
- ca ( u_clka X ) ( u_fa0 CLK ) + USE SIGNAL ;
- clk2 ( PIN clk2 ) ( u_clkb A ) + USE SIGNAL ;
- cb ( u_clkb X ) ( u_ln GATE_N ) ( u_fb0 CLK ) + USE SIGNAL ;
- d1 ( PIN d1 ) ( u_fa0 D ) + USE SIGNAL ;
- qln ( u_ln Q ) ( u_fb0 D ) + USE SIGNAL ;
- d2 ( PIN d2 ) ( u_ln D ) + USE SIGNAL ;
- ya ( u_fa0 Q ) ( PIN ya ) + USE SIGNAL ;
END NETS
END DESIGN
