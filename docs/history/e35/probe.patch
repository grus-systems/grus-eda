+/// 20%-80% slew of the driver-pin voltage of the pi load driven by the ramp `(t0, dt)` behind `rd`
+/// (implicit trapezoid on a fixed grid, linear interpolation of the crossings).
+fn driver_wave_slew(pi: &PiModel, rd: f64, dt: f64) -> f64 {
+    let c1 = pi.c1.max(1e-4 * pi.total());
+    let (c2, rpi) = (pi.c2, pi.rpi);
+    let (g, gp) = (1.0 / rd, 1.0 / rpi);
+    let (a11, a12) = (-(g + gp) / c1, gp / c1);
+    let (a21, a22) = (gp / c2, -gp / c2);
+    let steps = 4000usize;
+    let horizon = dt + 12.0 * (rd * pi.total() + rpi * c2);
+    let h = horizon / steps as f64;
+    let (m11, m12, m21, m22) = (1.0 - 0.5 * h * a11, -0.5 * h * a12, -0.5 * h * a21, 1.0 - 0.5 * h * a22);
+    let det = m11 * m22 - m12 * m21;
+    let vs = |t: f64| (t / dt).clamp(0.0, 1.0);
+    let (mut v1, mut v2) = (0.0f64, 0.0f64);
+    let (mut t20, mut t80) = (None, None);
+    let mut prev = (0.0, 0.0);
+    for k in 1..=steps {
+        let t = h * k as f64;
+        let rhs1 = v1 + 0.5 * h * (a11 * v1 + a12 * v2) + 0.5 * h * (vs(t - h) + vs(t)) * g / c1;
+        let rhs2 = v2 + 0.5 * h * (a21 * v1 + a22 * v2);
+        let (n1, n2) = ((rhs1 * m22 - m12 * rhs2) / det, (m11 * rhs2 - m21 * rhs1) / det);
+        v1 = n1;
+        v2 = n2;
+        let cross = |lvl: f64| prev.1 + (lvl - prev.0) / (v1 - prev.0) * h;
+        if t20.is_none() && v1 >= 0.2 {
+            t20 = Some(cross(0.2));
+        }
+        if t80.is_none() && v1 >= 0.8 {
+            t80 = Some(cross(0.8));
+        }
+        prev = (v1, t);
+    }
+    match (t20, t80) {
+        (Some(a), Some(b)) => b - a,
+        _ => f64::NAN,
+    }
+}
+
+fn probe_rd(table: &dyn Fn(f64) -> (f64, f64), c: f64, rd_scale: f64) -> f64 {
+    let h = 0.05 * c;
+    let (dsl, ssl) = ((table(c + h).0 - table(c - h).0) / (2.0 * h), (table(c + h).1 - table(c - h).1) / (2.0 * h));
+    let k: f64 = std::env::var("PROBE_SS").ok().and_then(|v| v.parse().ok()).unwrap_or(0.0);
+    (if k > 0.0 { k * ssl } else { rd_scale * dsl }).max(1e-6)
+}
